# Template for .env.
# Placeholder values.

# --- Backend: server ---
PORT=8080
APP_TIMEZONE=Asia/Colombo
FRONTEND_URL=http://localhost:5173

# --- Backend: database (docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5435/foodwastereducer
DB_USER=foodwaste
DB_PASSWORD=foodwaste

# --- Backend: security ---
# Minimum 32 characters.
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters
# Value of the X-Cron-Secret header.
CRON_SECRET=change-me-cron-secret

# --- Backend: email (Brevo) ---
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=you@example.com

# --- Backend: external APIs ---
MEALDB_API_KEY=1

# --- Frontend ---
# Empty locally. The Vite dev server proxies API calls.
VITE_API_URL=
